    <!-- PM-KISAN -->
    <string name="scheme_pm_kisan_name">पीएम-किसान</string>
    <string name="scheme_pm_kisan_purpose">पात्र शेतकरी कुटुंबांना आर्थिक सहाय्य प्रदान करते.</string>
    <string name="scheme_pm_kisan_benefits">पात्र शेतकऱ्यांना या योजनेद्वारे आर्थिक सहाय्य मिळते.</string>
    <string name="scheme_pm_kisan_eligibility">पात्रता सरकारने निश्चित केलेल्या नियम व अटींवर आधारित आहे.</string>
    <string name="scheme_pm_kisan_application">शेतकरी नोंदणी आणि अर्जाची स्थिती जाणून घेण्यासाठी अधिकृत पीएम-किसान माध्यमे आणि स्थानिक सरकारी मदत घेऊ शकतात.</string>

    <!-- Pradhan Mantri Awas Yojana -->
    <string name="scheme_pmay_name">प्रधानमंत्री आवास योजना</string>
    <string name="scheme_pmay_purpose">पात्र कुटुंबांना घर मिळविण्यास किंवा घरामध्ये सुधारणा करण्यास सहाय्य करते.</string>
    <string name="scheme_pmay_benefits">लागू योजनेच्या मार्गदर्शक तत्त्वांनुसार घरकुलासाठी आर्थिक सहाय्य दिले जाते.</string>
    <string name="scheme_pmay_eligibility">पात्रता संबंधित पीएमएवाय घटकांतर्गत कुटुंबाची परिस्थिती आणि आर्थिक निकषांवर अवलंबून असते.</string>
    <string name="scheme_pmay_application">अर्जदार अधिकृत सरकारी संकेतस्थळे किंवा स्थानिक प्रशासनामार्फत संबंधित पीएमएवाय अर्ज प्रक्रिया तपासू शकतात.</string>

    <!-- MGNREGA -->
    <string name="scheme_mgnrega_name">मनरेगा</string>
    <string name="scheme_mgnrega_purpose">ग्रामीण रोजगार आणि उपजीविका सुरक्षिततेसाठी कायदेशीर चौकट उपलब्ध करून देते.</string>
    <string name="scheme_mgnrega_benefits">पात्र ग्रामीण कुटुंबांना योजनेच्या तरतुदींनुसार रोजगाराची मागणी करता येते.</string>
    <string name="scheme_mgnrega_eligibility">अकुशल शारीरिक काम करण्यास इच्छुक असलेल्या प्रौढ सदस्यांचे ग्रामीण कुटुंब या कायद्याअंतर्गत रोजगाराची मागणी करू शकते.</string>
    <string name="scheme_mgnrega_application">कामगार ग्रामपंचायतीमार्फत नोंदणी करून कामाची मागणी करू शकतात.</string>

    <!-- Ayushman Bharat -->
    <string name="scheme_ayushman_name">आयुष्मान भारत</string>
    <string name="scheme_ayushman_purpose">लागू घटकांनुसार पात्र लाभार्थ्यांना आरोग्यसेवा मिळविण्यास सहाय्य करते.</string>
    <string name="scheme_ayushman_benefits">लागू कार्यक्रमाच्या मार्गदर्शक तत्त्वांनुसार पात्र लाभार्थ्यांना आरोग्यसेवा सुविधा मिळू शकतात.</string>
    <string name="scheme_ayushman_eligibility">पात्रता संबंधित लाभार्थी यादी आणि सरकारी निकषांवर अवलंबून असते.</string>
    <string name="scheme_ayushman_application">पात्रता आणि उपलब्ध सेवा अधिकृत सरकारी माध्यमे तसेच सहभागी आरोग्यसेवा केंद्रांमार्फत तपासता येतात.</string>

    <!-- Swachh Bharat Mission -->
    <string name="scheme_swachh_bharat_name">स्वच्छ भारत अभियान</string>
    <string name="scheme_swachh_bharat_purpose">स्वच्छता, आरोग्यदायी परिसर आणि सुधारित कचरा व्यवस्थापनाला प्रोत्साहन देते.</string>
    <string name="scheme_swachh_bharat_benefits">समुदायामध्ये स्वच्छता आणि कचरा व्यवस्थापनाशी संबंधित उपक्रमांना सहाय्य करते.</string>
    <string name="scheme_swachh_bharat_eligibility">लाभ आणि उपक्रम संबंधित कार्यक्रम आणि स्थानिक अंमलबजावणीवर अवलंबून असतात.</string>
    <string name="scheme_swachh_bharat_application">उपलब्ध उपक्रम आणि सहाय्याबाबत माहितीसाठी नागरिक स्थानिक सरकारी संस्थेशी संपर्क साधू शकतात.</string>

    <!-- Education Scholarships -->
    <string name="scheme_education_scholarships_name">शैक्षणिक शिष्यवृत्ती</string>
    <string name="scheme_education_scholarships_purpose">पात्र विद्यार्थ्यांना आर्थिक सहाय्य आणि शिष्यवृत्ती प्रदान करते.</string>
    <string name="scheme_education_scholarships_benefits">विशिष्ट शिष्यवृत्तीच्या नियमांनुसार पात्र विद्यार्थ्यांना शिक्षणासाठी आर्थिक सहाय्य मिळू शकते.</string>
    <string name="scheme_education_scholarships_eligibility">पात्रता शिष्यवृत्तीचा प्रकार, शैक्षणिक स्तर, उत्पन्न, प्रवर्ग आणि इतर अटींनुसार बदलते.</string>
    <string name="scheme_education_scholarships_application">विद्यार्थ्यांनी संबंधित अधिकृत शिष्यवृत्ती पोर्टल तपासून आवश्यक कागदपत्रांसह अर्ज करावा.</string>
